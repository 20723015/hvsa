{
  "schema": "hvsa-checkpoint-moment-design-v0",
  "date": "2026-10-12",
  "status": "design_only_not_runtime_config",
  "mode": "checkpoint_moment1",
  "statistic": "l2_norm_of_decoded_checkpoint_mean_minus_weighted_base_mean",
  "aggregation_weight": "sample_count_only",
  "beta": 0.9,
  "epsilon": 1e-12,
  "rho_min": 0.0,
  "rho_max": 2.0,
  "residual_kappa": 0.5,
  "base_alignment_gamma": 1.0,
  "initial_state": {"count": 0, "m": 0.0, "g": 0.0},
  "numerator": "bias_corrected_ema_including_current_verified_training_increment_norm",
  "denominator": "bias_corrected_ema_of_previously_committed_actual_model_step_norms",
  "fallback_rho": 1.0,
  "fallback_conditions": ["count_zero", "global_moment_at_most_epsilon", "base_gap_norm_at_most_epsilon"],
  "residual_cap": "norm((rho-1)*base_gap)<=residual_kappa*training_increment_norm",
  "state_advance_event": "ta_finalize_success_exactly_once",
  "invalid_input_policy": "reject_without_state_advance",
  "client_norm_input": false,
  "per_group_unmask": false,
  "quantize_scale": 1000000,
  "extra_staleness_weights": false,
  "extra_momentum_or_server_optimizer": false,
  "numeric_contract": "fixed_order_ieee754_binary64_no_fma_canonical_little_endian",
  "protocol_integration_complete": false,
  "training_evaluated": false
}
